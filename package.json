{
  "name": "dimensions-nfc-server",
  "version": "1.0.0",
  "description": "NFC Server for Dimensions project",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "eslint src frontend/src && npm run lint:md && npm run lint:json && npm run lint:yaml",
    "lint:json": "node -e \"const fs = require('fs'); ['package.json', 'tsconfig.json', 'frontend/package.json', 'frontend/tsconfig.json', 'frontend/tsconfig.app.json', 'frontend/tsconfig.node.json'].forEach(f => { try { JSON.parse(fs.readFileSync(f, 'utf8')); } catch(err) { console.error('JSON Parse Error in ' + f + ':', err.message); process.exit(1); } }); console.log('All JSON files are valid!');\"",
    "lint:yaml": "js-yaml .github/workflows/ci.yml",
    "lint:md": "markdownlint \"**/*.md\" --ignore node_modules --ignore frontend/node_modules --ignore scratch",
    "lint:md:fix": "markdownlint \"**/*.md\" --fix --ignore node_modules --ignore frontend/node_modules --ignore scratch",
    "format": "prettier --write \"src/**/*.ts\" \"**/*.md\"",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "helmet": "^7.1.0",
    "nconf": "^0.12.1",
    "picocolors": "^1.0.1",
    "usb": "^2.13.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/nconf": "^0.10.6",
    "@types/node": "^20.14.9",
    "@types/supertest": "^6.0.2",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "js-yaml": "^4.1.1",
    "markdownlint-cli": "^0.48.0",
    "prettier": "^3.3.2",
    "supertest": "^7.0.0",
    "tsx": "^4.15.6",
    "typescript": "^5.5.2",
    "typescript-eslint": "^8.59.2",
    "vitest": "^3.2.6"
  }
}
